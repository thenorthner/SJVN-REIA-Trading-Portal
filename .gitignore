node_modules/
.DS_Store
.env
backend/src/db/platform.db
backend/src/db/platform.db-journal
backend/src/db/platform.db-wal
backend/src/db/platform.db-shm
backend/uploads/disputes/**
!backend/uploads/disputes/.gitkeep
dist/
build/

# Logs
*.log

# Local databases / sqlite
*.db
*.sqlite
*.sqlite3

# Runtime uploads & generated/scraped files (keep folder, ignore contents)
backend/uploads/*
!backend/uploads/.gitkeep
backend/outbox/*
!backend/outbox/.gitkeep
# The mail/SMS file outbox also lands at the repo root when the server is run
# from there. Same runtime artifacts, same counterparty names in the subject
# lines — ignore both locations, not just the one under backend/.
outbox/
backend/rea_downloads/
backend/temp/
backend/test*.pdf

# CERC market-monitoring cache. The .xlsx files ARE tracked (small, ~3MB total)
# so autoSeedLocalReports can seed the market-intelligence dashboard offline on a
# fresh deploy. The .pdf copies (~14MB) are download-only reference — nothing
# parses or serves them — so they are ignored to keep the repo lean.
backend/cerc_downloads/**/*.pdf

# Local reference/data files dropped into the project root
/*.pdf
/*.PDF
/*.docx

# Reference/controlled documents (TCS manuals, real SJVN bills) — keep local, never commit
# Exclude the contents, not the directory itself — git will not descend into an
# excluded directory, so `docs/` followed by `!docs/*.md` silently keeps
# everything out.
docs/*
!docs/*.md

# Agent / editor local settings (keep launch.json shared, ignore machine-local)
.claude/settings.local.json

# Ad-hoc SSH tunnel / remote-deploy helpers. These tend to accumulate hardcoded
# hosts and passwords; deployment is deploy.sh + docs/deployment.md instead.
tunnel*.py
tunnel*.sh
start*tunnel*
*.exp
askpass.sh
deploy_remote*.py
deploy_runner.py
add_key_to_remote.py
remote-deploy-exec.sh
run_tunnel_auto.py

# Live ISET material — screenshots, exports and specs pulled from the real
# portal. Real counterparty names, tariffs and bank details live here, and this
# repo has a remote, so the whole folder is ignored except its README.
reference/**
!reference/README.md

# Seed data transcribed from those exports. The screens need sample rows to look
# like the real thing locally, but the rows carry real counterparty names,
# application numbers and amounts — so they load from here at runtime instead of
# sitting inline in tracked source. Every seeder degrades to "no sample data"
# when this folder is absent, which is what a fresh clone should get.
backend/src/data/live/**
backend/src/data/isetReportSeeds.json
