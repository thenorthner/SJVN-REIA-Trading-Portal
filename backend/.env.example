# SMTP — invoice + alert email. Leave SMTP_HOST empty to write to backend/outbox/.
# Mailtrap sandbox demo:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=587
#   SMTP_USER=<inbox username>
#   SMTP_PASS=<inbox password>
#   SMTP_FROM=reia-alerts@sjvn.local
#   SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sjvn.local
SMTP_SECURE=false

# Database snapshots — taken on boot and nightly at 01:00 IST, 14 kept.
# The default folder, backend/backups/, is on the same disk as the database:
# that covers a bad migration or a corrupted page, not a failed disk or a lost
# server. Point SJVN_BACKUP_DIR at a second disk or a mounted network share.
# The server warns at boot while the two share a disk.
# SJVN_BACKUP_DIR=/mnt/sjvn-backups
# SJVN_BACKUP_KEEP=14

# Optional SMS webhook (JSON POST { to, message })
# SMS_WEBHOOK_URL=

# JWT / public verify URL for invoice QR
# JWT_SECRET=sjvn-dev-secret-change-me
# PUBLIC_BASE_URL=http://localhost:4000

# PXIL member report APIs (Billing / Format-D / Member DOR / Reverse Auction / Trade Margin).
# Leave PXIL_ENABLED=false to run against the documented sample shapes instead of
# calling PXIL. These can also be set as masters params (pxil_api_token, etc.).
# PXIL_ENABLED=false
# PXIL_API_TOKEN=
# Production is https://dashboard.pxil.in; staging (stale data, run first) is
# https://stagingmypratyaydashboard.pxil.in. Each has its own token, and each
# only answers a public IP PXIL has whitelisted for it (403 otherwise).
# PXIL_BASE_URL=https://dashboard.pxil.in
# PXIL_PORTFOLIO_ID=

# IEX Front Office API (DAM/iDAM, GDAM, HPDAM, RTM; REC host known, client TBD).
# Leave IEX_ENABLED=false to run against the deterministic stub instead of
# calling the exchange. These can also be set as masters params (iex_api_token,
# iex_environment, ...) so the desk can rotate the token without a redeploy.
#
# Hosts are per segment and built into the client, switched by IEX_ENVIRONMENT
# (UAT | LIVE) — no base URL needed. IEX_BASE_URL overrides every segment at
# once and exists only for pointing at a mock.
#
# Tokens last six months; IEX documents no refresh endpoint and mails a
# replacement 15 days before expiry. A token whose own `exp` claim has passed
# warns but still sends, because IEX confirmed that claim can be wrong; set
# IEX_ENFORCE_TOKEN_EXPIRY=true to make it a hard refusal instead.
#
# Requests must originate from the IP whitelisted with IEX.
# IEX_ENABLED=false
# IEX_ENVIRONMENT=UAT
# IEX_PARTICIPANT_ID=
# IEX_LOGIN_USER_ID=
# IEX_API_TOKEN=
# IEX_BID_AREA_ID=ALL
# IEX_PORTFOLIO_ID=ALL
# IEX_BASE_URL=
# IEX_ENFORCE_TOKEN_EXPIRY=false
# Per-request timeout. The spec fixes 40s; lower it if the exchange hangs.
# IEX_TIMEOUT_MS=40000
# IEX allow 4 requests/second and document no error for exceeding it, so the
# client spaces its own calls. 0 disables the gate (for a mock only).
# IEX_MAX_REQUESTS_PER_SEC=4

# NOAR Trader API (SJVN's own open-access applications, read-only).
# Leave NOAR_API_ENABLED=false to run against the documented sample instead of
# calling the registry. Masters params exist too (noar_api_key, ...) but the
# SECRET should stay here: anything in master data is visible on the Masters
# screen to everyone who can open it.
#
# The key rides in the query string as TP_CLIENT_KEY, the secret is the bearer
# token, and they are one pair — the secret's JWT carries the key in its
# groupsid claim. A NOAR login holds ONE active key: generating a new one on the
# portal deactivates the key in use here (Trader API guide, p. 9). Do not
# generate; ask the holder of the login.
#
# Hosts are built in and chosen by NOAR_API_ENV: PRODUCTION external.noar.in,
# TEST devdr.noar.in:84. Requests must come from the IP Grid India whitelisted.
# NOAR_API_ENABLED=false
# NOAR_API_ENV=TEST
# NOAR_API_KEY=
# NOAR_API_SECRET=
# NOAR_TRADER_NAME=
# NOAR_API_BASE_URL=
# NOAR_API_TIMEOUT_MS=60000

# State WBES (block-wise approved schedules, read-only).
# The API key alone is not enough: the request body carries UserName and
# UtilAcronymList, and the guide states the username must match the credential
# the key was issued against. There is no base URL in the guide either — it is
# per WBES instance and has to be supplied by whoever holds the access.
#
# WBES_BASE_URL is the ORIGIN AND PREFIX ONLY, e.g.
# https://gateway.grid-india.in/POSOCO — the client appends
# /reports/1.0/WebAccessAPI/<endpoint> itself. Grid India hand out the full
# endpoint URL including "?apikey="; paste that here and normaliseBaseUrl() cuts
# it back, but the short form is what belongs in this field.
#
# The key goes in the X-API-Key header and, by default, also as the `apikey`
# query parameter — the guide allows either and Grid India documented the query
# form. Set WBES_KEY_IN_QUERY=false to keep the credential out of URLs once the
# header alone is known to be honoured.
# WBES_ENABLED=false
# WBES_API_KEY=
# WBES_BASE_URL=
# WBES_USERNAME=
# WBES_UTILITY_ACRONYM=
# WBES_KEY_IN_QUERY=true
