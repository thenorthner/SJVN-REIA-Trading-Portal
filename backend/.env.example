# SMTP ? invoice email distribution (Send to Buyer/Seller)
# Leave SMTP_HOST empty to write PDFs to backend/outbox/ (demo mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sjvn.local
SMTP_SECURE=false

# Optional SMS webhook (JSON POST { to, message })
# SMS_WEBHOOK_URL=

# JWT / public verify URL for invoice QR
# JWT_SECRET=sjvn-dev-secret-change-me
# PUBLIC_BASE_URL=http://localhost:4000
