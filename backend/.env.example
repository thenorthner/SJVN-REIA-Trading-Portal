# SMTP — invoice + alert email. Leave SMTP_HOST empty to write to backend/outbox/.
# Mailtrap sandbox demo:
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=587
#   SMTP_USER=<inbox username>
#   SMTP_PASS=<inbox password>
#   SMTP_FROM=reia-alerts@sjvn.local
#   SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sjvn.local
SMTP_SECURE=false

# Optional SMS webhook (JSON POST { to, message })
# SMS_WEBHOOK_URL=

# JWT / public verify URL for invoice QR
# JWT_SECRET=sjvn-dev-secret-change-me
# PUBLIC_BASE_URL=http://localhost:4000

# PXIL member report APIs (Billing / Format-D / Member DOR / Reverse Auction / Trade Margin).
# Leave PXIL_ENABLED=false to run against the documented sample shapes instead of
# calling PXIL. These can also be set as masters params (pxil_api_token, etc.).
# PXIL_ENABLED=false
# PXIL_API_TOKEN=
# PXIL_BASE_URL=https://dashboard.pxil.in
# PXIL_PORTFOLIO_ID=
# The daily TAM-GTAM path is unconfirmed — PXIL's document prints the slot-wise
# URL for both endpoints. Override here once they confirm it.
# PXIL_TAM_GTAM_PATH=tam-gtam

# IEX Front Office API (DAM/iDAM, GDAM, HPDAM, RTM; REC host known, client TBD).
# Leave IEX_ENABLED=false to run against the deterministic stub instead of
# calling the exchange. These can also be set as masters params (iex_api_token,
# iex_environment, ...) so the desk can rotate the token without a redeploy.
#
# Hosts are per segment and built into the client, switched by IEX_ENVIRONMENT
# (UAT | LIVE) — no base URL needed. IEX_BASE_URL overrides every segment at
# once and exists only for pointing at a mock.
#
# Tokens last six months; IEX documents no refresh endpoint and mails a
# replacement 15 days before expiry. A token whose own `exp` claim has passed
# warns but still sends, because IEX confirmed that claim can be wrong; set
# IEX_ENFORCE_TOKEN_EXPIRY=true to make it a hard refusal instead.
#
# Requests must originate from the IP whitelisted with IEX.
# IEX_ENABLED=false
# IEX_ENVIRONMENT=UAT
# IEX_PARTICIPANT_ID=
# IEX_LOGIN_USER_ID=
# IEX_API_TOKEN=
# IEX_BID_AREA_ID=ALL
# IEX_PORTFOLIO_ID=ALL
# IEX_BASE_URL=
# IEX_ENFORCE_TOKEN_EXPIRY=false
# Per-request timeout. The spec fixes 40s; lower it if the exchange hangs.
# IEX_TIMEOUT_MS=40000
